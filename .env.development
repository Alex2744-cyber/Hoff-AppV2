# Cargado solo en `expo start` (modo desarrollo). Tiene prioridad sobre `.env`.
# https://docs.expo.dev/guides/environment-variables/

# Backend en esta máquina (npm start en Hoff-Backend, puerto 3000).
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# En teléfono físico (misma Wi‑Fi), descomenta y pon la IP LAN de tu PC:
# EXPO_PUBLIC_DEV_API_URL=http://192.168.1.50:3000/api

# Solo si necesitas la UI en dev contra API remota (el servidor debe permitir tu origen en CORS):
# EXPO_PUBLIC_USE_REMOTE_API=1
# EXPO_PUBLIC_API_URL=https://api.tudominio.com/api
