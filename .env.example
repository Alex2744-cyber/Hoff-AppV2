# Copiar a .env si quieres sobreescribir la URL de la API.
# Expo solo carga variables EXPO_PUBLIC_* automáticamente.
#
# Producción (Vercel / EAS): obligatorio que coincida con el backend que usa tu base de datos.
# Ejemplo Railway (sin /api al final; el código lo añade si falta):
# EXPO_PUBLIC_API_URL=https://tu-servicio.up.railway.app
#
# Desarrollo: backend en esta máquina (móvil en la misma WiFi: IP del PC, no localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
#
# Opcional: URL de la futura app Finanzas (pestaña Finanzas en admin)
# EXPO_PUBLIC_FINANZAS_APP_URL=https://tu-app-finanzas.vercel.app
